#!/bin/sh

# Add all directories in `~/.local/bin` to $PATH
export PATH="$PATH:$(find ~/.local/bin -type d | paste -sd ':' -)"

# Add go installation to path
[ -d /usr/local/go/bin ] && export PATH=${PATH}:/usr/local/go/bin
[ -d "${CARGO_HOME}/bin" ] && export PATH="${PATH}:${CARGO_HOME}/bin"

# Set XDG variables
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
[ -e "${XDG_CONFIG_HOME:-~/.config}/user-dirs.dirs" ] && . "${XDG_CONFIG_HOME:-~/.config}/user-dirs.dirs"

# Enviroment Variables
export EDITOR="nvim"
export WIKI_PATH="${XDG_DOCUMENTS_DIR:-$HOME/documents}/wiki"
#export GIT_SSH_COMMAND="ssh -F ${HOME}/.ssh/config-git"

# Cloud synced directories
export NEXTCLOUD="$HOME/nextcloud"
export ONEDRIVE="$HOME/onedrive"
export PROTON="$HOME/proton"

# Cleanup variables
export OPENCLAW_HOME="${XDG_CONFIG_HOME}/openclaw"
export OPENCLAW_STATE_DIR="${XDG_STATE_HOME}/openclaw"
export OPENCLAW_CONFIG_PATH="${OPENCLAW_HOME}/openclaw.json"
export VSCODE_PORTABLE="$XDG_DATA_HOME/vscode"
export VSCODE_CLI_DATA_DIR="$XDG_DATA_HOME/vscode/cli"
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
#export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority" # This line will break some DMs.
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export PYTHONPYCACHEPREFIX="$XDG_CACHE_HOME/python"
export PYTHONUSERBASE="$XDG_DATA_HOME/python"
export MYSQL_HISTFILE="$XDG_DATA_HOME/mysql_history"
export NOTMUCH_CONFIG="$XDG_CONFIG_HOME/notmuch-config"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"
export WGETRC="$XDG_CONFIG_HOME/wgetrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ZDOTDIR="$XDG_CONFIG_HOME/shell/zsh"
export ZSH="${ZDOTDIR}/oh-my-zsh"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export WINEPREFIX="$XDG_DATA_HOME/wineprefixes/default"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export ANDROID_SDK_HOME="$XDG_CONFIG_HOME/android"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export INPUTRC="${XDG_CONFIG_HOME}/readline/inputrc"
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export ANSIBLE_HOME="$XDG_CONFIG_HOME/ansible"
#export ANSIBLE_CONFIG="$ANSIBLE_HOME/ansible.cfg"
export ANSIBLE_GALAXY_CACHE_DIR="${XDG_CACHE_HOME}/ansible/galaxy_cache"
export ANSIBLE_VAULT_PASSWORD_FILE="${ANSIBLE_HOME}/vault_password"
export ANSIBLE_INVENTORY="${ANSIBLE_HOME}/inventory/"
export DOTNET_CLI_HOME="$XDG_DATA_HOME/dotnet"
export NUGET_PACKAGES="$XDG_CACHE_HOME/NuGetPackages"
export OMNISHARPHOME="$XDG_CONFIG_HOME/omnisharp"
export UNISON="$XDG_DATA_HOME/unison"
export HISTFILE="$XDG_DATA_HOME/history"
export MBSYNCRC="$XDG_CONFIG_HOME/mbsync/config"
export ELECTRUMDIR="$XDG_DATA_HOME/electrum"
export PYTHONSTARTUP="$XDG_CONFIG_HOME/python/pythonrc"
export SQLITE_HISTORY="$XDG_DATA_HOME/sqlite_history"
export _JAVA_OPTIONS="-Djavafx.cachedir=${XDG_CACHE_HOME}/openjfx -Djava.util.prefs.userRoot=${XDG_CONFIG_HOME}/java"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/podman/podman.sock"
export RBENV_ROOT="$XDG_DATA_HOME/rbenv"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"

# Source .bashrc if running bash
[ -n "$BASH_VERSION" ] && . "$XDG_CONFIG_HOME/shell/bash/bashrc"
[ -e "${XDG_DATA_HOME}/cargo/env" ] && . "${XDG_DATA_HOME}/cargo/env"
