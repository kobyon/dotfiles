# sudo not required for some system commands
for command in mount umount sv pacman apt updatedb su shutdown poweroff reboot ; do
	alias $command="sudo $command"
done; unset command

alias vim="nvim"
alias nvchad="NVIM_APPNAME=nvim-nvchad ${HOME}/.local/bin/nvim.appimage"

# Make applications support XDG
alias yarn='yarn --use-yarnrc "$XDG_CONFIG_HOME/yarn/config"'

alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -vI"
alias ls="ls -hN --color=auto --group-directories-first"
alias grep="grep --color=auto"
alias diff="diff --color=auto"
alias ip="ip -color=auto"

alias dotfiles='/usr/bin/git --git-dir="$HOME/.local/src/dotfiles/" --work-tree="$HOME"'

alias voxbox='docker run -it --rm -v ${PWD}:/repo --entrypoint "" voxpupuli/voxbox:7'
alias voxbox-rake='docker run -it --rm -v ${PWD}:/repo --entrypoint "rake" voxpupuli/voxbox:7 -f /Rakefile'
alias search='grep -I -r -n --exclude-dir=_archive --exclude-dir=.git -exclude-dir=node_modules --exclude-dir=.venv'
