# SSH config file to select the correct github account

# Default github account: tastatur-troll
Host github.com
   HostName github.com
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes
   User git

# Upheads github account
Host github.com-upheads upgit
   HostName github.com
   IdentityFile ~/.ssh/git-upheads
   IdentitiesOnly yes
   User git

Host git.teknograd.no
   Hostname git.teknograd.no
   IdentityFile ~/.ssh/git-upheads
   IdentitiesOnly yes
   User git
