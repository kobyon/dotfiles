deploy-nginx-to-web003:
	ansible-playbook playbooks/config/nginx.yaml -l no12829v-web003 --ask-become-pass

deploy-netbox-config-prod:
	ansible-playbook playbooks/config/netbox.yaml -l no99123v-netbox002 --ask-become-pass

deploy-puppetmaster-prod:
	ansible-playbook playbooks/main/update-puppetmaster.yaml --limit no99123v-osl-pup006 --ask-become-pass

deploy-puppetmaster-dev:
	ansible-playbook playbooks/main/update-puppetmaster.yaml --limit no99123v-osl-pup005 --ask-become-pass

update-puppetlab:
	ansible-playbook playbooks/main/update-puppetmaster.yaml playbooks/main/update-puppet-agents.yaml --limit group_puppet_lab

ansible-facts host:
	ansible -i {{ inventory }} {{host}} -m setup -k

ansible-apply-role host role:
	ansible -i {{ inventory }} {{host}} -m include_role -a name={{role}}

ansible-inventory:
	ansible-inventory -i {{ inventory }} --list

run-on-server host +command:
	ssh {{host}} {{command}}

install-ruby:
	sudo apt-get install build-essential autoconf libssl-dev libyaml-dev zlib1g-dev libffi-dev libgmp-dev rustc
	mkdir -p "${RBENV_ROOT}"
	git clone https://github.com/rbenv/rbenv.git "${RBENV_ROOT}"
	git clone https://github.com/rbenv/ruby-build.git "$(rbenv root)"/plugins/ruby-build
	printf "%s\n" "List installable ruby versions by running: rbenv install -l"
	printf "%s\n" "Install ruby version by running: rbenv install <version>"
	printf "%s\n" "Set global ruby version by running: rbenv global <version>"
	printf "%s\n" "Set local ruby version by running: rbenv local <version>"
	printf "%s\n" "Install bundler by running: gem install bundler"

update-ansible-config:
	if [ ! -e "${XDG_PROJECTS_DIR:=${HOME}/projects}/ansible/playbooks/host-$(hostname -s).yaml" ]; then \
	  printf "%s\n" "Cannot find host ansible file $(hostname -s)..."; \
	  exit 1; \
	fi

	git -C "${XDG_PROJECTS_DIR:=${HOME}/projects}/ansible" pull --rebase --autostash

	ansible-playbook \
	"${XDG_PROJECTS_DIR:=${HOME}/projects}/ansible/playbooks/host-$(hostname -s).yaml" \
	--ask-become-pass \
	-e "file_header_hash=\"################################################################\\n# DO NOT EDIT - Managed by ansible!\\n# \\n# Host            : \{\{ inventory_hostname_short \}\} (\{\{ inventory_hostname \}\})\\n# Deployed by     : \{\{ playbook_runner \}\}\\n# Ansible version : \{\{ ansible_version.full \}\}\\n# Playbook path   : \{\{ playbook_name \}\}\\n# Play            : \{\{ ansible_play_name \}\}\\n# Host groups     : \{\{ group_names \}\}\\n#\\n# DO NOT EDIT - Managed by ansible!\\n################################################################\\n\""

update: update-ansible-config
