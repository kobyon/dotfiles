#!/bin/sh

adjust_docker_group() {
    host_docker_gid=$(stat -c '%g' /var/run/docker.sock 2>/dev/null || stat -f '%g' /var/run/docker.sock 2>/dev/null || echo "")
    container_docker_gid=$(getent group docker | cut -d: -f3)

    if [ -n "$host_docker_gid" ] && [ "$host_docker_gid" != "$container_docker_gid" ]; then
        echo "Adjusting docker group GID from $container_docker_gid to $host_docker_gid"
        if ! sudo groupmod -g "$host_docker_gid" docker 2>/dev/null; then
            echo "Warning: Failed to adjust docker group GID" >&2
        fi
    fi
}

clone_repos() {
    echo "Cloning repos from $REPOS_FILE..."
    mkdir -p "$PROJECTS_DIR"

    while IFS= read -r url; do
        case "$url" in ''|'#'*) continue ;; esac

        name=$(basename "$url" .git)
        dest="${PROJECTS_DIR}/${name}"

        if [ -d "${dest}/.git" ]; then
            echo "  ${name} exists, fetching..."
            git -C "$dest" fetch --all --prune || echo "  Warning: fetch failed for ${name}" >&2
        else
            echo "  Cloning ${url}..."
            git clone "$url" "$dest" || echo "  Warning: clone failed for ${name}" >&2
        fi
    done < "$REPOS_FILE"
}

REPOS_FILE=/usr/local/share/sakkenix/repos.txt
PROJECTS_DIR="/home/$(id -un)/projects"

# Run each bootstrap step only when its prerequisite is present.
if [ -S /var/run/docker.sock ]; then
    adjust_docker_group
fi

if [ -f "$REPOS_FILE" ]; then
    clone_repos
fi
